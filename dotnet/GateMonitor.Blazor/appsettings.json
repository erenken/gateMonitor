{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Remootio": {
    "DeviceIp": "{deviceIp}",
    "ApiSecretKey": "{apiSecretKey}",
    "ApiAuthKey": "{apiAuthKey}",
    "SendPingMessageEveryXMs": 60000,
    "AutoReconnect": true,
    "GateImageUrl": "{gateImageUrl}"
  }
}
