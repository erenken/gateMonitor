{
  "name": "gate-monitor",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "buildService": "ng build remootio-angular",
    "verifyServiceVersion": "node scripts/verify-package-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "deployService": "npm run versionService && npm run buildService && npm run verifyServiceVersion && npm publish ./dist/remootio-angular --access public",
    "prestart": "npm run buildService",
    "versionService": "node scripts/set-package-version.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "crypto-js": "^4.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.4",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.63.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
